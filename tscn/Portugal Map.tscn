script = ExtResource("8_gau84")
city_name = "Elvas"
map_position = Vector3(0.9753296, 0.15500642, 0.6106795)
description = "Rising from the plains of the Alentejo, Elvas stands as one of Portugal’s great frontier strongholds. Its immense star-shaped fortifications, bastions and guarded gates bear witness to centuries of conflict with neighbouring Spain. Within the fortified walls, merchants, soldiers and craftsmen move through narrow streets lined with whitewashed houses, while the surrounding fields sustain a largely agricultural population. The memory of past sieges lingers in the stonework, and the nearby border ensures that military vigilance remains part of everyday life. In Elvas, peace is precious, but never taken for granted."
province_name = "Alto Alentejo"
