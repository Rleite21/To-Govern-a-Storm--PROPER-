[sub_resource type="Resource" id="Resource_mtadd"]
script = ExtResource("8_gau84")
city_name = "Crato"
map_position = Vector3(0.6381643, 0.15500644, 0.23198032)
description = "In the heart of the Alto Alentejo, Crato bears the remnants of a once-powerful religious and military order. Its castle, churches and former monastic buildings recall the Knights of St John, whose influence once extended across the region. Beyond these weathered monuments, vast estates and open plains sustain a rural society shaped by livestock, agriculture and the authority of landowners. Life unfolds beneath an unforgiving sun, where labour is hard and opportunities are few. Crato is a place of faded grandeur, where the stones remember a power that the passing centuries have diminished."
province_name = "Alto Alentejo"
population = 3255
specializations = Array[ExtResource("9_iwx5t")]([SubResource("Resource_q06er")])
density = 0
society = 8514
traits = Array[int]([0, 10])

