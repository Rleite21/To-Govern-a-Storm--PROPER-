[sub_resource type="Resource" id="Resource_i4e54"]
script = ExtResource("8_gau84")
city_name = "Mangualde"
map_position = Vector3(0.5238266, 0.15500642, -1.0408919)
description = "Situated amid the granite hills, vineyards and small agricultural holdings of the Beira Alta, Mangualde serves as a modest commercial centre for its surrounding communities. Its fortunes are bound to the land, the movement of regional produce and the labour of families whose lives remain far removed from the political intrigues of the capital. The Catholic Church continues to shape social customs and communal identity, while republican officials and educated professionals advocate greater administrative reach and modern schooling. Property owners and merchants seek stability, but the rural poor remain vulnerable to economic hardship. In Mangualde, the struggle between tradition and reform unfolds gradually, through municipal affairs, parish life and the everyday demands of survival."
province_name = "Beira Alta"
