[sub_resource type="Resource" id="Resource_5p402"]
script = ExtResource("8_gau84")
city_name = "Chaves"
map_position = Vector3(0.71036863, 0.15500642, -2.1218395)
description = "Near the Spanish border, Chaves stands as a historic gateway between Portugal and Galicia. Its Roman bridge spans the Tâmega River, a reminder of the armies, merchants and travellers who have crossed these lands for centuries. The town’s thermal springs draw visitors seeking relief in their warm waters, while agriculture, livestock and regional trade sustain the surrounding countryside. Stone fortifications recall generations of border conflicts, and the proximity of Spain gives local life a distinctive frontier character. In Chaves, Roman legacies and rural traditions endure beneath the watchful presence of an ancient stronghold."
province_name = "Trás-os-Montes"
tier = 2
population = 37419
specializations = Array[ExtResource("9_iwx5t")]([SubResource("Resource_3oh3t"), SubResource("Resource_af7lr")])
