[sub_resource type="Resource" id="Resource_6u58o"]
script = ExtResource("8_gau84")
city_name = "Amarante"
map_position = Vector3(0.2854867, 0.15500642, -1.6664951)
description = "Straddling the Tâmega River, Amarante is a town of granite houses, ancient bridges and solemn churches, steeped in the traditions of northern Portugal. Surrounded by green hills and vineyards, its people live by the land, the wine and the rhythms of the river. Yet when heavy rains descend, the Tâmega can swell into a destructive force, flooding streets and threatening riverside homes. Beneath the watchful presence of Saint Gonçalo, faith remains a powerful anchor in a community shaped by harsh nature, enduring traditions and generations of hardship."
province_name = "Douro Litoral"
tier = 2
population = 52116
