[sub_resource type="Resource" id="Resource_1t6g0"]
script = ExtResource("8_gau84")
city_name = "Tomar"
map_position = Vector3(0.00692169, 0.15500642, -0.09664619)
description = "Dominated by the monumental Convent of Christ, Tomar is a city whose identity is inseparable from the Knights Templar, the Order of Christ and Portugal's age of maritime expansion. Its historic centre and the Nabão River reflect centuries of religious, military and commercial importance, while the surrounding region sustains agriculture and a growing variety of crafts and industrial activities. The city's legacy of Catholic and monastic power sits uneasily beside the secular ideals of the Republic, which abolished religious orders and confiscated church property following the revolution of 1910. Nevertheless, religious heritage remains a source of civic pride, even among those who support the new political order. Merchants, professionals and local republicans seek progress and stability, while conservative Catholics preserve the memory of an older Portugal. Tomar is a city where the monuments of a sacred past endure beneath a republic determined to redefine the nation."
province_name = "Ribatejo"
tier = 2
population = 37420
specializations = Array[ExtResource("9_iwx5t")]([SubResource("Resource_017wa"), SubResource("Resource_3x0m2"), SubResource("Resource_hptlo"), SubResource("Resource_cdneq")])
density = 2
