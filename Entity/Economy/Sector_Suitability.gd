	T.BRIGHT_ACADEMIA: {
		S.FINANCE: 1.2,
		S.TRADE_SERVICES: 1.2,
		S.MANUFACTURING: 1.1,
		S.CIVIL_ENGINEERING: 1.1,
	},
	T.SKILLED_WORKFORCE: {
		S.MANUFACTURING: 1.4,
		S.HEAVY_INDUSTRY: 1.3,
		S.ARMS: 1.3,
		S.CIVIL_ENGINEERING: 1.2,
	},
	T.POWERFUL_LANDOWNERS: {
		S.AGRICULTURE: 1.5,
		S.MINING: 1.2,
	},
	T.PROVINCIAL_CROSSROADS: {
