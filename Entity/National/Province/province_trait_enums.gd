static func get_enum(category: Category) -> Dictionary:
	match category:
		Category.GEOGRAPHIC: return Geographic
		Category.ECONOMIC: return Economic
		Category.INFRASTRUCTURE: return Infrastructure
		Category.INSTITUTIONAL: return Institutional
		Category.SOCIAL: return Social
		Category.CULTURAL: return Cultural
		Category.POLITICAL: return Political
	return {}


static func from_string(category: Category, text: String) -> int:
	var key := text.strip_edges().to_upper().replace(" ", "_").replace("-", "_")
	var e := get_enum(category)
	return e[key] if e.has(key) else -1


static func to_display(category: Category, value: int) -> String:
	var e := get_enum(category)
	var idx := e.values().find(value)
	return e.keys()[idx].capitalize() if idx >= 0 else "Unknown"


static func is_dynamic(category: Category) -> bool:
	return category != Category.GEOGRAPHIC
