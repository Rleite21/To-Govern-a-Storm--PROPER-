[resource]
script = ExtResource("1_vpxpt")
city_name = "Loulé"
description = "In the rolling countryside of the central Algarve, Loulé gathers the produce of inland farms beneath the towers and whitewashed walls of its historic centre. Its celebrated market draws farmers, craftsmen and traders from surrounding villages, sustaining a regional economy rooted in agriculture, livestock and small-scale commerce. Catholic festivals and traditional associations remain central to community life, while republican municipal politics offers a growing arena for local notables and professionals. Yet the hardships of rural labour and the uneven distribution of land and wealth leave much of the population distant from the promises of political modernisation. Loulé is a town of enduring custom, quietly exposed to the changes reaching the southern provinces."
population = 72344
specializations = Array[ExtResource("2_smpl2")]([SubResource("Resource_jef8g"), SubResource("Resource_46ieu"), SubResource("Resource_x2rpp")])
density = 2
society = 10562
traits = Array[int]([0, 4, 12, 11, 10])
