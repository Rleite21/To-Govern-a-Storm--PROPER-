[resource]
script = ExtResource("1_cjh32")
city_name = "Fundão"
map_position = Vector3(2.8302188, 0.6200257, -2.417161)
description = "Nestled between the slopes of the Serra da Gardunha and the vast heights of the Serra da Estrela, Fundão is a fertile town known for its orchards, vineyards and agricultural markets. Cherry trees flourish across the surrounding countryside, while farmers cultivate the land beneath the shadow of the mountains. Local commerce connects scattered rural communities, though life remains governed by the seasons and the demands of agricultural labour. Fundão is a place where the richness of the soil stands in contrast to the hardships of mountain life."
province_name = "Beira Baixa"
population = 27754
