[resource]
script = ExtResource("1_ye5om")
city_name = "Portalegre"
map_position = Vector3(2.8906224, 0.6200257, 1.0106647)
description = "ituated on the slopes of the Serra de São Mamede, Portalegre commands a landscape of wooded hills, agricultural estates and routes linking the Alentejo to the Spanish frontier. Its identity is shaped by textile production, regional commerce and the surrounding countryside, where large landholdings coexist with the precarious livelihoods of agricultural labourers. The town's workshops and manufacturing establishments give it a more varied social character than many rural settlements, bringing employers, artisans and wage workers into closer contact. Republican ideas find support among sections of the urban middle classes, while Catholic traditions and conservative proprietors remain influential. Beneath the apparent calm of provincial life lies the same unresolved question confronting the Republic: whether political modernisation can improve the condition of ordinary people without provoking a deeper struggle over property, labour and authority."
province_name = "Alto Alentejo"
population = 22368
specializations = Array[ExtResource("2_ugemt")]([SubResource("Resource_82ky0"), SubResource("Resource_afalj")])
density = 2
society = 2374
