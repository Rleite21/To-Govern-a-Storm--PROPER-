[resource]
script = ExtResource("1_koyic")
city_name = "Covilhã"
map_position = Vector3(0.7503732, 0.15500642, -0.78321046)
description = "Climbing the steep slopes of the Serra da Estrela, Covilhã is a town built on wool, water and hard labour. Its textile mills and workshops transform wool from the surrounding mountains into cloth, their machinery and smoke marking the town as one of Portugal’s important industrial centres. Workers endure long hours in crowded factories, while merchants and mill owners profit from the growing textile trade. Beyond the industrial streets, mountain villages cling to old traditions beneath the imposing peaks. In Covilhã, the demands of industry collide with the harsh realities of working-class life."
province_name = "Beira Baixa"
