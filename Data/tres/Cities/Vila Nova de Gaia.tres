[resource]
script = ExtResource("1_aapue")
city_name = "Vila Nova de Gaia"
description = "Stretching along the southern bank of the Douro opposite Porto, Vila Nova de Gaia owes its international reputation to the great wine lodges where Port wine is stored and matured before shipment abroad. Its riverside warehouses, merchant houses and commercial connections reflect an economy deeply tied to export trade, while its growing working population supports transport, industry and the wine business. The fortunes of the town are closely linked to those of Porto's merchant bourgeoisie, whose commercial success contrasts with the modest circumstances of many labourers. Catholic traditions remain influential, but republican politics and organised labour find a receptive audience in the industrial districts of the region. Gaia occupies a distinctive position between commerce and production, where international markets, local employment and the social tensions of the Republic meet along the banks of the Douro."
population = 323202
specializations = Array[ExtResource("2_iubpx")]([SubResource("Resource_qwrqs"), SubResource("Resource_3517e"), SubResource("Resource_hy4jf"), SubResource("Resource_ri856"), SubResource("Resource_j0xmm"), SubResource("Resource_211ox")])
density = 4
