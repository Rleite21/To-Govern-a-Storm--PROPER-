[resource]
script = ExtResource("1_jba3t")
city_name = "Caldas da Rainha"
description = "Renowned for its thermal springs, Caldas da Rainha has long drawn visitors seeking relief from illness and the burdens of everyday life. Its hospital, founded under the patronage of Queen Leonor, remains a symbol of the town’s charitable heritage. Around the bustling markets, pottery workshops and small businesses sustain a lively local economy, while distinctive ceramics reflect the artistic spirit of the region. Beneath the familiar rhythm of trade and healing, Caldas preserves an identity shaped by royal patronage, craftsmanship and the enduring belief in the restorative power of its waters."
population = 58983
