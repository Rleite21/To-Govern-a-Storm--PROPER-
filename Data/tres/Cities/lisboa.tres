[resource]
script = ExtResource("1_ttevi")
city_name = "Lisboa"
map_position = Vector3(-0.5638501, 0.15500642, 0.71844184)
description = "The capital of the Portuguese Republic is a city of contradictions, where grand avenues and cafés of the bourgeoisie stand beside crowded tenements, dockside taverns and working-class neighbourhoods. Its hills overlook the Tagus, still the great artery of an empire whose former splendour cannot conceal the country's economic weakness. Since the Revolution of 1910, Lisbon has been the principal battleground between republican factions, monarchist sympathisers, Catholic traditionalists and militant secularists. Freemasons, military officers, industrialists, socialists and anarchists all compete to shape the future, while strikes, inflation and successive political crises unsettle daily life. Here, the Republic's greatest ambitions and deepest failures are laid bare."
province_name = "Oeste"
tier = 0
population = 658236
specializations = Array[ExtResource("2_o4heh")]([SubResource("Resource_60m07"), SubResource("Resource_2rnfx"), SubResource("Resource_qxoln"), SubResource("Resource_1lvyb"), SubResource("Resource_lfbn8"), SubResource("Resource_8oclv")])
